TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Single shared password for /admin
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie
SESSION_SECRET=generate-a-long-random-string

# Public site URL for Open Graph previews (production domain)
# NEXT_PUBLIC_SITE_URL=https://eyes-on-batumi.vercel.app

# Optional tip / support link on photo pages
# NEXT_PUBLIC_TIP_URL=https://buymeacoffee.com/yourpage

# Telegram bot (photo delivery + booking in chat)
# BOT_TOKEN=                    # same token from @BotFather (or use TELEGRAM_BOT_TOKEN)
# ADMIN_TELEGRAM_ID=            # your numeric Telegram user id
# TELEGRAM_BOT_USERNAME=        # bot username without @, for share links
# TELEGRAM_WEBHOOK_SECRET=      # optional random string for webhook auth

# Website booking alerts (optional if bot handles bookings)
# TELEGRAM_CHAT_ID=

# Weekly summary cron auth (set any random string, add to Vercel env)
# CRON_SECRET=

# Vercel Blob (custom prefix IMAGES_ if you named the store Images)
# IMAGES_STORE_ID=
# IMAGES_READ_WRITE_TOKEN=
